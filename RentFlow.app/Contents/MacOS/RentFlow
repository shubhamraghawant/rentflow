#!/bin/zsh
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
PROJECT_DIR="/Users/shubhamraghawant/Documents/Projects/rentflow"
cd "$PROJECT_DIR"

# Check if server is already running on port 4000
if ! curl -s http://localhost:4000/api/health >/dev/null 2>&1; then
  node server.js >/dev/null 2>&1 &
  sleep 0.8
fi

# Try launching in Chrome app mode if Chrome exists, else default browser
if [ -d "/Applications/Google Chrome.app" ]; then
  open -na "Google Chrome" --args --app="http://localhost:4000"
elif [ -d "/Applications/Brave Browser.app" ]; then
  open -na "Brave Browser" --args --app="http://localhost:4000"
else
  open "http://localhost:4000"
fi
